{
  "name": "nixship",
  "version": "0.1.0",
  "private": true,
  "author": "Rituraj Basak",
  "license": "Apache-2.0",
  "repository": "https://github.com/imxade/nixship",
  "homepage": "https://github.com/imxade/nixship#readme",
  "bugs": "https://github.com/imxade/nixship/issues",
  "description": "LAN-first Next.js control plane for deploying trusted Nix flake applications on Nix-capable devices.",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.0.0"
  },
  "pnpm": {
    "overrides": {
      "nanoid": "3.3.17",
      "postcss": "8.5.18",
      "sharp": "0.35.0"
    }
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "DISABLE_PLATFORM_RUNTIME=1 next build && tsc -p tsconfig.server.json",
    "start": "NODE_ENV=production node dist-server/server.js",
    "start:ci": "tsx scripts/start-ci.ts",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:fix": "biome check --write .",
    "biome:ci": "biome ci .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "test:deployment": "tsx tests/integration/deployment.ts",
    "test:examples": "tsx tests/integration/examples.ts",
    "test:github-public": "tsx tests/integration/public-github.ts",
    "test:harbur-private": "tsx tests/integration/harbur-private.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "pnpm biome:ci && pnpm typecheck && pnpm test && pnpm build",
    "db:doctor": "tsx scripts/db-doctor.ts",
    "security:check": "tsx scripts/security-check.ts",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts"
  },
  "dependencies": {
    "better-sqlite3": "13.0.1",
    "jszip": "3.10.1",
    "next": "16.2.11",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tldts": "7.4.10",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.1.0",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "daisyui": "5.6.15",
    "tailwindcss": "4.3.3",
    "tsx": "4.20.6",
    "typescript": "5.9.2",
    "vitest": "4.1.10"
  }
}
