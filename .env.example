# Optional. Defaults to ~/.local/share/nix-platform
PLATFORM_DATA_DIR=

# Dashboard listener
HOSTNAME=0.0.0.0
PORT=3000

# Recommended for portable backups. When omitted, Nix Ship generates a local mode-0600 key file.
# Generate with: openssl rand -base64 32
PLATFORM_MASTER_KEY=

# Optional stable public dashboard origin. Custom Cloudflare dashboard domains take
# priority; otherwise the supervised Quick Tunnel URL is used for GitHub webhooks.
PLATFORM_PUBLIC_URL=

# cloudflared executable name or absolute path.
CLOUDFLARED_BIN=cloudflared

# Account-free temporary public URLs for the dashboard and every web app.
# Each URL remains while Nix Ship and its cloudflared process keep running, but can
# change after shutdown, reboot, crash, or process recreation. Disable globally for
# private-only nodes.
QUICK_TUNNELS_ENABLED=true
QUICK_TUNNEL_RECONCILE_SECONDS=10

# Runtime controls
BUILD_CONCURRENCY=1
SOURCE_POLL_SECONDS=60
METRICS_INTERVAL_SECONDS=5
MIN_FREE_DISK_MB=1024
MIN_FREE_MEMORY_MB=256
RELEASE_RETENTION=5
LOG_RETENTION_DAYS=7
LOG_MAX_MB=1024
LOG_LEVEL=info

# Optional initial AI assistant. Remote endpoints must use HTTPS. A trusted local
# OpenAI-compatible endpoint may use HTTP only with private-network access enabled.
PLATFORM_AI_BASE_URL=
PLATFORM_AI_MODEL=
PLATFORM_AI_API_KEY=
PLATFORM_AI_ALLOW_PRIVATE_NETWORK=false
PLATFORM_AI_TIMEOUT_SECONDS=60
